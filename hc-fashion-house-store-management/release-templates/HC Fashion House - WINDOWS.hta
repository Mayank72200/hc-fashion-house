<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>HC Fashion House</title>
  <HTA:APPLICATION
    ID="hcfh"
    APPLICATIONNAME="HCFashionHouseLauncher"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal"
    CONTEXTMENU="no"
    BORDER="thin"
    INNERBORDER="no"
    SCROLL="auto"
    MAXIMIZEBUTTON="no"
    ICON="_system\app-icon.ico" />
  <style>
    /* Trident (IE11) renders this window: no CSS variables, no grid, no flex
       gap. Centred blocks and floats look identical on Windows 7 to 11.

       This screen is for shop staff who have never installed anything that
       was not an .exe, so it is deliberately large and short of words: one
       thing to read, one thing to click, everything else behind a link. */
    html, body {
      margin: 0; padding: 0;
      background: #0d1526;
      color: #eef3fa;
      font-family: "Segoe UI", Arial, sans-serif;
      text-align: center;
    }

    /* ---- brand ---- */
    #brand { padding: 30px 30px 0; }
    #brand .mark, #brand .markFb {
      width: 64px; height: 64px;
      border-radius: 15px;
    }
    #brand .markFb {
      display: none;
      background: #111111;
      color: #C9A24A;
      font-size: 26px; font-weight: 700;
      line-height: 64px;
    }
    h1 {
      margin: 14px 0 0;
      font-size: 27px;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    #tagline {
      margin: 5px 0 0;
      font-size: 13px;
      color: #8ba0c0;
    }

    /* ---- what is going on ---- */
    #state { padding: 26px 34px 0; }
    #stateTitle {
      margin: 0;
      font-size: 19px;
      font-weight: 600;
      line-height: 1.35;
    }
    #stateBody {
      margin: 8px 0 0;
      font-size: 14px;
      line-height: 1.6;
      color: #9db1cf;
    }
    #stateBody b { color: #e3ecf8; font-weight: 600; }
    .ok   #stateTitle { color: #5ee9a0; }
    .warn #stateTitle { color: #fbbf24; }
    .err  #stateTitle { color: #fb7185; }

    /* ---- the one thing to click ---- */
    #primaryWrap { padding: 24px 34px 0; }
    .big {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: 20px 16px;
      font-family: inherit;
      font-size: 19px;
      font-weight: 600;
      color: #fff;
      background: #16a34a;
      border: 0;
      border-radius: 13px;
      cursor: pointer;
    }
    .big:hover { background: #15803d; }
    .big.blue { background: #2563eb; }
    .big.blue:hover { background: #1d4ed8; }
    .big .sub {
      display: block;
      margin-top: 5px;
      font-size: 12.5px;
      font-weight: 400;
      color: #e0f5e8;
    }
    .big.blue .sub { color: #dde8ff; }

    /* ---- steps, only where they are the whole answer ---- */
    #steps {
      margin: 22px 34px 0;
      padding: 16px 18px;
      background: #121d33;
      border: 1px solid #1f2d48;
      border-radius: 12px;
      text-align: left;
      font-size: 13.5px;
      line-height: 1.75;
      color: #a5b8d4;
    }
    #steps b { color: #e3ecf8; font-weight: 600; }
    #steps ol { margin: 0; padding-left: 20px; }
    #steps li { margin-bottom: 6px; }

    /* ---- everything else ---- */
    #moreToggle {
      display: inline-block;
      margin: 18px 0 0;
      font-size: 13px;
      color: #7fa8ee;
      cursor: pointer;
    }
    #moreToggle:hover { text-decoration: underline; }
    #more { display: none; padding: 12px 34px 0; }
    .small {
      display: block;
      width: 100%;
      box-sizing: border-box;
      margin-bottom: 7px;
      padding: 12px 14px;
      font-family: inherit;
      font-size: 13.5px;
      color: #dce6f4;
      background: #182440;
      border: 1px solid #26344f;
      border-radius: 9px;
      cursor: pointer;
    }
    .small:hover { background: #20304f; border-color: #3a4e76; }

    /* ---- footer ---- */
    footer {
      margin-top: 26px;
      padding: 12px 30px 14px;
      border-top: 1px solid #1a2438;
      font-size: 11.5px;
      color: #5f7191;
    }
    footer a { color: #7fa8ee; text-decoration: none; }
    footer a:hover { text-decoration: underline; }
    #where {
      display: block;
      margin-top: 6px;
      font-family: Consolas, "Courier New", monospace;
      font-size: 10px;
      color: #47566f;
      word-break: break-all;
    }
  </style>
</head>
<body>

<div id="brand">
  <img class="mark" id="mark" alt=""
       onerror="this.style.display='none'; document.getElementById('markFb').style.display='inline-block';" />
  <div class="markFb" id="markFb">HC</div>
  <h1>HC Fashion House</h1>
  <p id="tagline">Your invoices stay on this computer.</p>
</div>

<div id="state">
  <p id="stateTitle">Checking&hellip;</p>
  <p id="stateBody"></p>
</div>

<div id="primaryWrap"></div>

<div id="steps"></div>

<span id="moreToggle" onclick="toggleMore(); return false;"></span>
<div id="more"></div>

<footer>
  <a href="#" onclick="openFolder(); return false;">Open this folder</a>
  &nbsp;&middot;&nbsp;
  <a href="#" onclick="showHelp(); return false;">Get help</a>
  <span id="where"></span>
</footer>

<script>
  // HC Fashion House - HTA launcher
  //
  // The one file a Windows user ever double-clicks. It installs the app and
  // opens it, so it only ever shows what makes sense now:
  //   * opened from inside the ZIP        -> tell them to extract it
  //   * part of the package missing       -> say so; ask for a fresh copy
  //   * already installed somewhere else  -> open that copy instead
  //   * extracted, not installed          -> "Install" (copies the app to
  //                                          %LOCALAPPDATA%\Programs\HC Fashion House)
  //   * installed                         -> "Open App", the rest behind More
  //
  // Design decisions:
  //   * IE-era JScript (no arrow functions, no let/const, no template
  //     strings) because HTA runs on the Trident engine.
  //   * One headline, one button. Backup, Restore, Move and Stop are real
  //     but rare, so they live behind "More options" instead of making the
  //     first screen look like a control panel.
  //   * All the real work is done by PowerShell scripts in _system/. This
  //     file is a front door, not the app.
  //   * Nothing here opens a web site or downloads anything. Help is the
  //     contact line and the guide that came with the app.
  //   * The app never updates itself. A new version is installed by the
  //     administrator (READ ME FIRST, "FOR THE ADMINISTRATOR").
  //   * The logo is the 128 px HC monogram PNG that ships in the built app
  //     (_system/dist/brand/hc-monogram-128.png), with a CSS-drawn square
  //     behind it for when that file is not there - which is exactly the
  //     state a worried user is staring at, and a broken-image glyph there
  //     reads as a broken download. Not the ICO: in an <img>, mshta always
  //     draws an icon's 16 px frame, scaled up and blurred. The window and
  //     taskbar icon stay _system/app-icon.ico (HTA:APPLICATION ICON). (A
  //     base64 data: URI was tried first; mshta blocks data: URIs in img,
  //     so it rendered nothing at all.)
  //   * The folder path appears once, in the footer. It used to be pasted
  //     into the error message too, where a long path wrapped over three
  //     lines and made the window look broken.

  var shell = new ActiveXObject("WScript.Shell");
  var fso = new ActiveXObject("Scripting.FileSystemObject");

  var CONTACT = 'Contact your HC Fashion House administrator.';
  var SHORTCUT = 'HC Fashion House.lnk';
  // Written by install-windows.ps1 as its last step: only then is a copy
  // installed. (The ZIP ships node_modules, so that folder cannot tell.)
  var MARKER = '_system\\hcfh-installed.json';

  // Resolve the folder this HTA lives in. location.pathname is
  // "file:///C:/path/to/HC%20Fashion%20House%20-%20WINDOWS.hta" - we strip
  // the filename, url-decode, and normalize slashes.
  function launcherFolder() {
    var p = location.pathname;
    p = p.replace(/^\/*/, '');
    p = decodeURIComponent(p);
    p = p.replace(/\//g, '\\');
    var idx = p.lastIndexOf('\\');
    return idx === -1 ? '' : p.substring(0, idx);
  }
  var ROOT = launcherFolder();
  var SYSTEM = ROOT + '\\_system';
  // Where Install puts the app: on this PC only, never a synced folder.
  var INSTALL_ROOT = shell.ExpandEnvironmentStrings('%LOCALAPPDATA%\\Programs\\HC Fashion House');

  // The launcher sits next to _system/, so the mark has a known absolute
  // path. A relative src would resolve against the current directory,
  // which is not always this folder.
  document.getElementById('mark').src = 'file:///' + (SYSTEM + '\\dist\\brand\\hc-monogram-128.png').replace(/\\/g, '/');

  function fileExists(rel) { return fso.FileExists(ROOT + '\\' + rel); }

  // Windows lets you double-click a file INSIDE a .zip without extracting
  // anything: it copies that ONE file to %TEMP%\Temp1_<name>.zip\... and
  // runs it there, with no siblings. The launcher then truthfully reports
  // that _system is missing while Explorer, still showing the ZIP, plainly
  // lists it - which reads as a bug. Reported 2026-09-23.
  function runningFromZip() {
    return ROOT.toLowerCase().indexOf('\\appdata\\local\\temp\\') !== -1;
  }

  // Paths can contain & and < ; the footer line is innerHTML.
  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  }

  function samePath(a, b) {
    return String(a).toLowerCase().replace(/\\+$/, '') === String(b).toLowerCase().replace(/\\+$/, '');
  }

  // An environment variable's value, or '' when it is not set.
  function envVar(name) {
    var v = shell.ExpandEnvironmentStrings('%' + name + '%');
    return (v && v.charAt(0) !== '%') ? v : '';
  }

  // Folders whose contents are copied to the cloud on many PCs: the OneDrive
  // roots, and the Desktop and Documents folders (often redirected into
  // OneDrive). Only these roots count - never a folder that merely has
  // "OneDrive" in its name. Same rule as hcfh-paths.ps1.
  function inSyncedFolder(path) {
    var roots = [envVar('OneDrive'), envVar('OneDriveCommercial'), envVar('OneDriveConsumer'),
                 shell.SpecialFolders('Desktop'), shell.SpecialFolders('MyDocuments'),
                 envVar('USERPROFILE') ? envVar('USERPROFILE') + '\\Desktop' : '',
                 envVar('USERPROFILE') ? envVar('USERPROFILE') + '\\Documents' : ''];
    var p = String(path).toLowerCase().replace(/\\+$/, '') + '\\';
    for (var i = 0; i < roots.length; i++) {
      if (!roots[i]) continue;
      var r = String(roots[i]).toLowerCase().replace(/\\+$/, '') + '\\';
      if (p.indexOf(r) === 0) return true;
    }
    return false;
  }

  // Runs a PowerShell script under _system/ with UAC-neutral defaults.
  // Style 1 = visible window (the user watches the install happen),
  // false = don't wait, so this window stays alive and keeps polling.
  function runScript(name, args) {
    var scriptPath = SYSTEM + '\\' + name;
    if (!fso.FileExists(scriptPath)) {
      alert('Missing file: ' + name + '\n\nPlease ask for a fresh copy of the HC Fashion House ZIP.\n' + CONTACT);
      return false;
    }
    var cmd = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + scriptPath + '"' + (args ? ' ' + args : '');
    try { shell.Run(cmd, 1, false); return true; }
    catch (e) { alert('Could not start ' + name + ':\n' + e.message); return false; }
  }

  function openFolder() { shell.Run('explorer.exe "' + ROOT + '"', 1, false); }
  function openDownloads() {
    shell.Run('explorer.exe "' + shell.ExpandEnvironmentStrings('%USERPROFILE%\\Downloads') + '"', 1, false);
  }
  // The staff guide that ships in _system, else the READ ME FIRST beside
  // this launcher. Both open in Notepad: nothing goes online.
  function openReadme() {
    var guides = [SYSTEM + '\\README.md', ROOT + '\\READ ME FIRST.txt'];
    for (var i = 0; i < guides.length; i++) {
      if (fso.FileExists(guides[i])) { shell.Run('notepad.exe "' + guides[i] + '"', 1, false); return; }
    }
    alert('The guide (README) is missing from the _system folder.\n\n' + CONTACT);
  }
  function showHelp() {
    alert('Need help?\n\n' + CONTACT + '\n\nThe guide is the file "READ ME FIRST" next to this launcher.');
  }
  // Same rule as hcfh-paths.ps1: <install>\Backups, beside _system.
  function backupsFolder() {
    if (envVar('HCFH_BACKUP_DIR')) return envVar('HCFH_BACKUP_DIR');
    if (envVar('HCFH_HOME')) return envVar('HCFH_HOME').replace(/\\+$/, '') + '\\Backups';
    return ROOT + '\\Backups';
  }
  function openBackups() {
    var b = backupsFolder();
    try { if (!fso.FolderExists(b)) fso.CreateFolder(b); } catch (e) { }
    shell.Run('explorer.exe "' + b + '"', 1, false);
  }

  // The package is all there: server, Node.js and app packages.
  function runtimeOk(root) {
    return fso.FileExists(root + '\\_system\\node\\node.exe') &&
           fso.FileExists(root + '\\_system\\node_modules\\express\\package.json');
  }
  function installedAt(root) {
    return fso.FileExists(root + '\\_system\\server.js') && fso.FileExists(root + '\\' + MARKER);
  }
  function invoiceCount(root) {
    var n = 0;
    try {
      var fc = new Enumerator(fso.GetFolder(root + '\\_system\\data\\bills').Files);
      for (; !fc.atEnd(); fc.moveNext()) { if (/\.json$/i.test(fc.item().Name)) n++; }
    } catch (e) { }
    return n;
  }
  function folderHasItems(path) {
    try { var f = fso.GetFolder(path); return (f.Files.Count + f.SubFolders.Count) > 0; }
    catch (e) { return false; }
  }

  function installState() {
    if (!fso.FolderExists(SYSTEM) || !fileExists('_system\\package.json') || !fileExists('_system\\server.js')) {
      // Only the books left: what the uninstaller leaves behind.
      if (folderHasItems(SYSTEM + '\\data')) return 'uninstalled';
      return 'no-system';
    }
    var ok = runtimeOk(ROOT);
    if (fileExists(MARKER)) return ok ? 'ready' : 'broken';
    return ok ? 'not-installed' : 'no-runtime';
  }

  // Is the app already installed in ANOTHER folder? A new ZIP extracts to a
  // new folder, Install there would make a second, empty copy, and the
  // shortcuts would move to it, so the invoices would seem to vanish. The
  // shortcuts the installer makes say where the real install is; so does
  // the standard program folder.
  function readText(path) {
    try { var f = fso.OpenTextFile(path, 1); var t = f.ReadAll(); f.Close(); return t; }
    catch (e) { return ''; }
  }
  function findOtherInstall() {
    var roots = [];
    var places = [shell.SpecialFolders('Desktop'), shell.SpecialFolders('Programs')];
    for (var i = 0; i < places.length; i++) {
      var lnk = places[i] + '\\' + SHORTCUT;
      if (!fso.FileExists(lnk)) continue;
      try {
        var target = String(shell.CreateShortcut(lnk).Arguments).replace(/^\s*"|"\s*$/g, '');
        var cut = target.lastIndexOf('\\');
        if (cut > 0) roots.push(target.substring(0, cut));
      } catch (e) { }
    }
    roots.push(INSTALL_ROOT);
    for (var j = 0; j < roots.length; j++) {
      var r = roots[j];
      if (!r || samePath(r, ROOT) || !installedAt(r)) continue;
      var m = /"version"\s*:\s*"([^"]+)"/.exec(readText(r + '\\_system\\package.json'));
      return { root: r, version: m ? m[1] : '', invoices: invoiceCount(r) };
    }
    return null;
  }
  // Opens the installed copy by starting ITS app (server + browser). Not its
  // launcher: this window is SINGLEINSTANCE, so a second one would not open.
  function openOther(other) {
    var p = other.root + '\\_system\\start-windows.ps1';
    if (!fso.FileExists(p)) { alert('Missing file in the installed copy: start-windows.ps1\n\n' + CONTACT); return; }
    shell.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + p + '"', 1, false);
  }
  function showFolder(path) { shell.Run('explorer.exe "' + path + '"', 1, false); }

  // ---- painting -------------------------------------------------------
  function setState(title, body, kind) {
    document.getElementById('stateTitle').innerHTML = title;
    document.getElementById('stateBody').innerHTML = body || '';
    document.getElementById('state').className = kind || '';
  }

  function setSteps(html) {
    var el = document.getElementById('steps');
    if (!html) { el.style.display = 'none'; return; }
    el.style.display = 'block';
    el.innerHTML = html;
  }

  function setPrimary(label, sub, onclickFn, blue) {
    var wrap = document.getElementById('primaryWrap');
    clearChildren(wrap);
    if (!label) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'block';
    var b = document.createElement('button');
    b.className = 'big' + (blue ? ' blue' : '');
    b.appendChild(document.createTextNode(label));
    if (sub) {
      var s = document.createElement('span');
      s.className = 'sub';
      s.appendChild(document.createTextNode(sub));
      b.appendChild(s);
    }
    b.onclick = onclickFn;
    wrap.appendChild(b);
  }

  // Everything that is real but rare. Hidden until asked for, so the first
  // screen is one sentence and one button.
  var moreOpen = false;
  function setMore(items) {
    var more = document.getElementById('more');
    var toggle = document.getElementById('moreToggle');
    clearChildren(more);
    if (!items || !items.length) {
      toggle.style.display = 'none';
      more.style.display = 'none';
      return;
    }
    toggle.style.display = 'inline-block';
    for (var i = 0; i < items.length; i++) {
      var b = document.createElement('button');
      b.className = 'small';
      b.appendChild(document.createTextNode(items[i].label));
      b.onclick = items[i].run;
      more.appendChild(b);
    }
    moreOpen = false;
    more.style.display = 'none';
    toggle.innerHTML = 'More options &#9662;';
  }

  function toggleMore() {
    moreOpen = !moreOpen;
    document.getElementById('more').style.display = moreOpen ? 'block' : 'none';
    document.getElementById('moreToggle').innerHTML =
      moreOpen ? 'Fewer options &#9652;' : 'More options &#9662;';
    fitWindow();
  }

  function clearChildren(el) {
    while (el.firstChild) el.removeChild(el.firstChild);
  }

  // ---- watching a script's black window -------------------------------
  // The scripts run in their own PowerShell window and this one has no way
  // of being told when they finish. A launcher that kept offering "Install"
  // after the install looked exactly like an install that did not work. So
  // poll for what the script actually changes. Cheap filesystem checks
  // only - this runs every two seconds.
  var watchTimer = null;
  var watchTicks = 0;
  function watch(done, onTimeout) {
    stopWatching();
    watchTicks = 0;
    watchTimer = window.setInterval(function () {
      watchTicks++;
      if (done()) {
        stopWatching();
        render();
        return;
      }
      // Never strand the user on a screen with no buttons.
      if (watchTicks > 300) {          // 10 minutes
        stopWatching();
        if (onTimeout) onTimeout();
      }
    }, 2000);
  }

  function stopWatching() {
    if (watchTimer) { window.clearInterval(watchTimer); watchTimer = null; }
  }

  var justInstalled = false;
  function startInstall() {
    if (!runScript('install-windows.ps1')) return;
    justInstalled = true;
    setState('Installing&hellip;',
      'A black window is doing the work. Leave it alone - it closes by itself, and the app ' +
      'opens in your browser when it is done.', 'warn');
    setPrimary(null);
    setSteps('');
    setMore(null);
    watch(function () { return installedAt(INSTALL_ROOT) || installedAt(ROOT); }, function () {
      render();
      setState('That did not finish',
        'If the black window has closed, the install did not complete. Read what it said, then try again below.', 'warn');
    });
    fitWindow();
  }

  // Nothing changes on this screen until the black window has removed the
  // program; if it is cancelled there, this screen simply stays as it is.
  function startUninstall() {
    if (!runScript('uninstall-windows.ps1')) return;
    watch(function () { return !fileExists(MARKER) && !fileExists('_system\\server.js'); }, null);
  }

  function render() {
    draw();
    fitWindow();
  }

  function draw() {
    var state = installState();
    document.getElementById('where').innerHTML = esc(ROOT);

    if (state === 'no-system') {
      if (runningFromZip()) {
        setState('Please extract the ZIP first',
          'Windows opened this file straight out of the ZIP, so the rest of the app did not ' +
          'come with it.', 'err');
        setPrimary('Open my Downloads folder', 'The ZIP is in there', openDownloads, true);
        setSteps(
          '<ol>' +
          '<li>Close this window.</li>' +
          '<li>Right-click the <b>HC-Fashion-House</b> ZIP and choose <b>Extract All&hellip;</b>.</li>' +
          '<li>Open the new folder and double-click <b>HC Fashion House - WINDOWS</b>.</li>' +
          '</ol>');
        setMore([{ label: 'Get help', run: showHelp }]);
        return;
      }
      setState('Some files are missing',
        'The <b>_system</b> folder is not next to this launcher, so there is nothing to start. ' +
        'The usual cause is a ZIP that was only half extracted.', 'err');
      setPrimary('Open my Downloads folder', 'Find the ZIP you got from HC Fashion House', openDownloads, true);
      setSteps('<ol><li>Extract the ZIP again, completely, and open the launcher in the new folder.</li>' +
        '<li>Still missing? ' + CONTACT + '</li></ol>');
      setMore([{ label: 'Open this folder and look', run: openFolder }]);
      return;
    }

    if (state === 'uninstalled') {
      setState('HC Fashion House was removed',
        'The program was uninstalled from this folder. Your books are still here: invoices and ' +
        'settings in <b>_system\\data</b>, saved PDFs in <b>_system\\Saved Invoices</b>, and the ' +
        'backup ZIPs in <b>Backups</b>.', 'warn');
      setPrimary(null);
      setSteps('<ol><li>To use them again, install HC Fashion House again from its ZIP. ' +
        'The installer finds them here and keeps using them.</li></ol>');
      setMore([{ label: 'Open this folder', run: openFolder }]);
      return;
    }

    if (state === 'no-runtime' || state === 'broken') {
      setState('Part of the app is missing',
        'Node.js or the app packages (the <b>node</b> and <b>node_modules</b> folders in ' +
        '<b>_system</b>) are missing, so the app cannot start. They come inside the ' +
        'HC Fashion House ZIP; nothing is downloaded.' +
        (state === 'broken' ? ' Your invoices are safe in <b>_system\\data</b>.' : ''), 'err');
      if (state === 'broken') {
        setPrimary('Back up my data', 'Saves a backup ZIP first', function () { runScript('backup-windows.ps1'); }, true);
        setSteps('<ol><li>Back up your data (the button above).</li>' +
          '<li>' + CONTACT + ' The fix is to uninstall (your books are kept) and install ' +
          'again from a fresh copy of the ZIP. If your antivirus removed the files, add this ' +
          'folder to its exclusions first.</li></ol>');
        setMore([
          { label: 'Uninstall (keeps your books)', run: startUninstall },
          { label: 'Open this folder', run: openFolder }
        ]);
      } else {
        setPrimary('Open my Downloads folder', 'Find the ZIP you got from HC Fashion House', openDownloads, true);
        setSteps('<ol><li>Extract the ZIP again, completely. If your antivirus removed files, ' +
          'add the folder to its exclusions.</li>' +
          '<li>Still missing? ' + CONTACT + '</li></ol>');
        setMore([{ label: 'Open this folder and look', run: openFolder }]);
      }
      return;
    }

    if (state === 'not-installed') {
      // Already installed elsewhere: send them there instead of installing a
      // second copy with its own, empty set of invoices.
      var other = findOtherInstall();
      if (other && justInstalled) {
        setState('Installed',
          'HC Fashion House is installed in <b>' + esc(other.root) + '</b>. From now on, open it ' +
          'from the <b>HC Fashion House</b> shortcut on your Desktop.', 'ok');
        setPrimary('Open App', 'Starts the app', function () { openOther(other); }, false);
        setSteps('<ol><li>This folder is not needed any more. You can delete it.</li></ol>');
        setMore([{ label: 'Show the app folder', run: function () { showFolder(other.root); } }]);
        return;
      }
      if (other) {
        setState('Already installed on this computer',
          'HC Fashion House is installed in <b>' + esc(other.root) + '</b>' +
          (other.version ? ' (version ' + esc(other.version) + ')' : '') +
          ', with <b>' + other.invoices + '</b> invoice' + (other.invoices === 1 ? '' : 's') + '. ' +
          'Keep using that copy so all your invoices stay together.', 'warn');
        setPrimary('Open the installed copy', 'Starts the app from that folder',
          function () { openOther(other); }, true);
        setSteps('<ol><li>Open the app from your <b>HC Fashion House</b> shortcut as usual.</li>' +
          '<li>Installing a new version? See "FOR THE ADMINISTRATOR" in READ ME FIRST, or ' +
          'ask your HC Fashion House administrator.</li>' +
          '<li>Otherwise this folder is not needed. You can delete it.</li></ol>');
        setMore([
          { label: 'Show its folder', run: function () { showFolder(other.root); } },
          { label: 'Read the guide', run: openReadme }
        ]);
        return;
      }
      var here = samePath(ROOT, INSTALL_ROOT);
      var kept = invoiceCount(here ? ROOT : INSTALL_ROOT);
      setState('Ready to install',
        (here ? 'One click. It sets everything up here and opens the app by itself.'
              : 'One click. It copies the app to <b>' + esc(INSTALL_ROOT) + '</b> on this PC, sets ' +
                'everything up and opens the app by itself.') +
        (kept ? ' The <b>' + kept + '</b> invoice' + (kept === 1 ? '' : 's') + ' already there ' +
                (kept === 1 ? 'is' : 'are') + ' kept.' : '') +
        (!here && inSyncedFolder(ROOT) ? ' This folder syncs to the cloud, so the app is not installed here.' : ''),
        'warn');
      setPrimary('Install', 'Nothing to fill in, nothing to download', startInstall, false);
      setSteps('');
      setMore([{ label: 'Read the guide first', run: openReadme }]);
      return;
    }

    // Installed in this folder.
    var synced = inSyncedFolder(ROOT);
    setState('Ready',
      'Your app is installed. It opens in your browser.' +
      (synced ? '<br><b>This folder syncs to the cloud</b> (OneDrive, Desktop or Documents), so ' +
                'your invoices are copied there too. Ask your HC Fashion House administrator to ' +
                'move the app to <b>' + esc(INSTALL_ROOT) + '</b>.' : ''),
      synced ? 'warn' : 'ok');
    setPrimary('Open App', 'Starts the app', function () { runScript('start-windows.ps1'); }, false);
    setSteps('');
    setMore([
      { label: 'Back up my data', run: function () { runScript('backup-windows.ps1'); } },
      { label: 'Restore a backup', run: function () { runScript('restore-windows.ps1'); } },
      { label: 'Move to another PC', run: function () { runScript('move-windows.ps1'); } },
      { label: 'Open the backups folder', run: openBackups },
      { label: 'Stop the app', run: function () { runScript('stop-windows.ps1'); } },
      { label: 'Uninstall (keeps your books)', run: startUninstall }
    ]);
  }

  // Size the window to whatever this state is showing, so nothing is ever
  // behind a scrollbar. HTA opens at a size of its own choosing and the
  // states differ in height by 300px, so measure: ask for a known height,
  // see how much of it the client area got, and the difference is the
  // title bar and borders.
  function fitWindow() {
    try {
      var w = 480;
      window.resizeTo(w, 700);
      var chrome = 700 - document.documentElement.clientHeight;
      var need = document.body.offsetHeight + chrome + 4;
      var max = screen.availHeight - 40;
      if (need > max) need = max;
      if (need < 320) need = 320;
      window.resizeTo(w, need);
      window.moveTo(Math.max(0, (screen.availWidth - w) / 2),
                    Math.max(0, (screen.availHeight - need) / 2));
    } catch (e) { }
  }

  window.onload = function () { render(); };
</script>

</body>
</html>
