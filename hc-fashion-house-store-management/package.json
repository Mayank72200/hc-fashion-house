{
  "name": "hc-fashion-house-store-management",
  "version": "1.0.0",
  "private": true,
  "description": "HC Fashion House store billing and GST management",
  "author": "HC Fashion House",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "server": "node server.js",
    "prebuild": "node scripts/bundle-tesseract-assets.mjs",
    "dev": "node scripts/bundle-tesseract-assets.mjs && (start /b node server.js) && vite",
    "build": "vite build",
    "start": "npm run build && node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "bundle:tesseract": "node scripts/bundle-tesseract-assets.mjs",
    "guard": "node scripts/brand-guard.mjs --src",
    "guard:dist": "node scripts/brand-guard.mjs --dist",
    "release:zip": "npm run guard && npm run lint && npm run test:unit && npm run build && npm run guard:dist && node scripts/build-release-zip.mjs && node scripts/verify-release.mjs",
    "test": "npm run test:unit && node tests/smoke.mjs",
    "test:unit": "node -e \"let failed=0;for(const s of ['tax-test','discount-modes-test','csv-test']){const r=require('child_process').spawnSync(process.execPath,['scripts/'+s+'.mjs'],{stdio:'inherit'});if(r.status!==0){failed++;console.error('FAILED: scripts/'+s+'.mjs')}}process.exit(failed?1:0)\"",
    "test:install": "playwright install firefox",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fflate": "^0.8.3",
    "globals": "^16.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@trickfilm400/rollup-plugin-off-main-thread": "3.0.0-pre1"
  }
}
