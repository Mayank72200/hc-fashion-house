# Logs (the server also writes egress-guard.log and csp.log to <app>/logs/)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
release-build
*.local

# Invoice data (personal/financial - keep local only)
data/
Saved Invoices/
Trash/
Backups/

# Backups and exports saved by the app or the launcher. A copy saved inside
# this folder holds the whole books, so it must never be committed.
hc-fashion-house-*.json
hc-fashion-house-*.pdf
*-backup-*.json
*.zip
# ... except deliberate test fixtures
!tests/fixtures/**

# Portable Node.js runtime for release builds (an official Windows ZIP of
# about 30 MB). It is copied here on each build machine and not committed;
# scripts/build-release-zip.mjs pins its version and SHA-256.
vendor/node/

# npm cache, if one is kept inside the working copy
.npm-cache/

# AI assistant context
.claude/

# OCR files copied into public/tesseract/ by scripts/bundle-tesseract-assets.mjs
# before every build and dev start (worker and cores from node_modules, the
# language data from vendor/tessdata). Generated, so not committed.
public/tesseract/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Session scratch from other agent tooling — not part of the project
.zcode
